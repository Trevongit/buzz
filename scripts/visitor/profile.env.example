# Copy to a local untracked file. Do not put nsec here.
# Seat secrets stay in ~/.buzz-dev/agents/<seat>/agent.env

BUZZ_SEAT_ID=codex-buzz
VISITOR_ROLE=codex
VISITOR_REQUIRE_MENTION=1
VISITOR_NAMES=codex-buzz,Buzz-codex
VISITOR_WATCH_SECS=15
VISITOR_COOLDOWN_SECS=30
# BUZZ_RELAY_URL is loaded from the seat. All teammates must match that relay.
